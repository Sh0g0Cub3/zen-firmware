#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        rcmd {
            bindings = <&kp RIGHT_COMMAND>;
            key-positions = <34 35>;
            layers = <0>;
        };

        choon {
            bindings = <&kp MINUS>;
            key-positions = <32 33>;
            layers = <0>;
        };
    };

    behaviors {
        lt_mkp: lt_mkp {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&mkp>;
        };
    };

    macros {
        en: en_kp {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings =
                <&macro_tap &kp LANG2>,
                <&macro_param_1to1 &macro_press &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_param_1to1 &macro_release &kp MACRO_PLACEHOLDER>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp TAB           &kp Q  &kp W     &kp E             &kp R  &kp T  &kp Y      &kp U      &kp I  &kp O           &kp P           &kp BSPC
&kp LEFT_CONTROL  &kp A  &kp S     &kp D             &kp F  &kp G  &kp H      &kp J      &kp K  &kp L           &kp SEMICOLON   &kp BACKSLASH
&kp LSHFT         &kp Z  &kp X     &kp C             &kp V  &kp B  &mo 4      &mo 3      &kp N  &kp M           &kp COMMA       &kp DOT          &kp UP_ARROW  &kp SLASH
&kp ESCAPE        &mo 3  &kp LALT  &kp LEFT_COMMAND  &mo 2  &to 0  &kp SPACE  &kp ENTER  &mo 2  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;
        };

        layer_1 {
            bindings = <
&kp TAB           &kp LG(LS(N3))  &kp LG(LS(N4))        &kp LG(LS(N5))    &kp R      &kp T                  &none      &kp LG(LEFT_BRACKET)  &kp LG(RIGHT_BRACKET)  &none      &none           &kp BSPC
&kp LEFT_CONTROL  &kp A           &kp LG(LEFT_BRACKET)  &mkp RCLK         &mkp LCLK  &kp LG(RIGHT_BRACKET)  &none      &mkp MB1              &mkp RCLK              &none      &none           &none
&kp LSHFT         &kp Z           &kp X                 &kp C             &kp V      &none                  &mo 4      &none                 &kp LC(UP_ARROW)       &mkp LCLK  &lt_mkp 2 RCLK  &none     &none  &none
&kp ESCAPE        &none           &kp LALT              &kp LEFT_COMMAND  &mo 2      &to 0                  &kp SPACE  &kp ENTER             &none                  &none      &none           &none
            >;
        };

        layer_2 {
            bindings = <
&en GRAVE         &en N1   &en N2    &en N3            &en N4    &en N5          &en N6     &en N7          &en N8             &en N9                    &en N0             &kp BSPC
&kp LEFT_CONTROL  &en SQT  &en DQT   &en BACKSLASH     &en PIPE  &en UNDERSCORE  &en TILDE  &en LEFT_BRACE  &en RIGHT_BRACE    &en LEFT_BRACKET          &en RIGHT_BRACKET  &kp ENTER
&kp LSHFT         &none    &none     &none             &none     &none           &en MINUS  &en PLUS        &kp C_VOLUME_DOWN  &kp LC(LG(LEFT_BRACKET))  &kp LC(LG(SPACE))  &kp LC(LG(RIGHT_BRACKET))  &kp C_VOLUME_UP  &en SLASH
&kp ESCAPE        &none    &kp LALT  &kp LEFT_COMMAND  &none     &none           &kp SPACE  &en EQUAL       &none              &none                     &none              &none
            >;
        };

        layer_3 {
            bindings = <
&none             &kp F1        &kp F2        &kp F3        &kp F4        &kp F5      &none           &en FSLH  &en ASTRK  &en KP_NUMBER_7  &en KP_NUMBER_8  &en KP_NUMBER_9
&kp LEFT_CONTROL  &kp F6        &kp F7        &kp F8        &kp F9        &kp F10     &kp HOME        &none     &en MINUS  &en KP_NUMBER_4  &en KP_NUMBER_5  &en KP_NUMBER_6
&kp LSHFT         &kp F11       &kp F12       &out OUT_USB  &out OUT_BLE  &bt BT_NXT  &bt BT_CLR_ALL  &none     &kp END    &none            &en GRAVE        &en KP_NUMBER_1  &en KP_NUMBER_2  &en KP_NUMBER_3
&bt BT_SEL 0      &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none       &none           &none     &none      &en KP_NUMBER_0  &en DOT          &en EQUAL
            >;
        };

        layer_4 {
            bindings = <
&kp TAB           &kp LG(LS(N3))  &kp LG(LS(N4))        &kp LG(LS(N5))    &kp R      &kp T                  &none      &kp LG(LEFT_BRACKET)  &kp LG(RIGHT_BRACKET)  &none      &none           &kp BSPC
&kp LEFT_CONTROL  &kp A           &kp LG(LEFT_BRACKET)  &mkp RCLK         &mkp LCLK  &kp LG(RIGHT_BRACKET)  &none      &mkp MB1              &mkp RCLK              &none      &none           &none
&kp LSHFT         &kp Z           &kp X                 &kp C             &kp V      &none                  &mo 4      &none                 &kp LC(UP_ARROW)       &mkp LCLK  &lt_mkp 2 RCLK  &none     &none  &none
&kp ESCAPE        &none           &kp LALT              &kp LEFT_COMMAND  &mo 2      &to 0                  &kp SPACE  &kp ENTER             &none                  &none      &none           &none
            >;
        };

        layer_5 {
            bindings = <
&kp ESC  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F12
&none    &none   &none   &none   &none   &none   &none   &none   &none   &none   &none    &none
&none    &none   &none   &none   &none   &none   &none   &none   &none   &none   &none    &none    &none  &none
&none    &none   &none   &none   &none   &none   &none   &none   &none   &none   &none    &none
            >;
        };

        layer_6 {
            bindings = <
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
            >;
        };
    };
};

&zip_temp_layer {
    require-prior-idle-ms = <300>;
    excluded-positions = <12 15 16 19 20 24 33 34 40 41>;
};
